{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Music Zamlr",
  "version": "0.1.0",
  "identifier": "com.zamlr.music",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Music Zamlr",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "publisher": "Francisco Javier Alcalá Soler (Curro)",
    "copyright": "Copyright (c) 2026 Francisco Javier Alcalá Soler (Curro)",
    "shortDescription": "Compare two music collections and import what you are missing.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "resources": {
      "binaries/": "backend/"
    }
  }
}
